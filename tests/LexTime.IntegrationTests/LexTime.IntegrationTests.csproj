<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Integration tests running against a real SQL Server 2022 container via Testcontainers. Constitution P11 forbids an in-memory or file-based provider anywhere in this project.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.13.0" />
    <!--
      Direct reference solely to lift a transitive dependency out of a vulnerable range.
      Testcontainers 4.13.0 (the latest release) pulls SSH.NET 2025.1.0 through
      Docker.DotNet.Enhanced, and GHSA-q939-rpr3-3284 makes NuGetAudit fail the build under
      the pipeline's warnaserror. SSH.NET is only reached when Testcontainers talks to a
      Docker daemon over SSH, which this project never does, but P24 treats an audit finding
      as a finding rather than as noise. Remove this line once a Testcontainers release
      carries the patched version itself.
    -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LexTime.Api\LexTime.Api.csproj" />
    <ProjectReference Include="..\..\src\LexTime.Infrastructure\LexTime.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\LexTime.Domain\LexTime.Domain.csproj" />
  </ItemGroup>

</Project>
